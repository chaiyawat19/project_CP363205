<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title><%= title %></title>
    <style>
        .btn {
            padding: 8px 15px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            margin: 5px;
        }
        .btn-primary { background-color: #007bff; color: white; }
        .btn-success { background-color: #28a745; color: white; }
        .btn-warning { background-color: #ffc107; color: black; }
        .btn-danger { background-color: #dc3545; color: white; }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            padding: 20px;
        }
        th, td {
            padding: 12px;
            text-align: center;
            border: 1px solid #ddd;
        }
        th { background-color: #f8f9fa; }
        .badge {
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 12px;
        }
        .badge-admin { background-color: #dc3545; color: white; }
        .badge-user { background-color: #6c757d; color: white; }
        .user-profile {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }
        .add_user {
            margin-bottom: 15px;
            font-size: 1.2rem;
        }
        .box_add_user {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <h1><%= title %></h1>
        <div class="box_add_user">
            <a href="/admin/manage_user/add" class="btn btn-success add_user">+ เพิ่มผู้ใช้ใหม่</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th rowspan="2">รูปโปรไฟล์</th>
                    <th rowspan="2">ชื่อผู้ใช้</th>
                    <th rowspan="2">อีเมล</th>
                    <th rowspan="2">บทบาท</th>
                    <th rowspan="2">แผนก</th>
                    <th rowspan="2">วันที่สร้าง</th>
                    <th rowspan="2">วันที่แก้ไขล่าสุด</th>
                    <th colspan="2">จัดการ</th>
                </tr>
                <tr>
                    <th>แก้ไข</th>
                    <th>ลบ</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="9" style="text-align: center;">ไม่พบข้อมูลผู้ใช้</td>
                    </tr>
                <% } else { %>
                    <% users.forEach(user => { %>
                    <tr>
                        <!-- <td>
                            <img 
                                src="<%= user.userProfile && user.userProfile.includes('iran.liara.run') ? 
                                    'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.fname + '+' + user.lname) + '&background=37b594&color=fff' 
                                    : user.userProfile %>" 
                                alt="Profile" class="user-profile">
                        </td> -->
                        <td><img src="<%= user.userProfile %>" alt="Profile" class="user-profile"></td>
                        <td><%= user.fname %> <%= user.lname %></td>
                        <td><%= user.email %></td>
                        <td>
                            <span class="badge <%= user.userRole === 'admin' ? 'badge-admin' : 'badge-user' %>">
                                <%= user.userRole %>
                            </span>
                        </td>
                        <td><%= user.department ? user.department.name : '-' %></td>
                        <td><%= new Date(user.createdAt).toLocaleDateString('th-TH') %></td>
                        <td><%= new Date(user.updatedAt).toLocaleDateString('th-TH') %></td>

                        <% if (user.email === 'testadmin@gmail.com' && user.fname === 'Super' && user.lname === 'Admin') { %>
                            <td colspan="2">
                                <button class="btn btn-warning" onclick="verifySuperAdmin('<%= user._id %>')">แก้ไข (ต้องยืนยันรหัส)</button>
                            </td>
                        <% } else { %>
                            <td>
                                <a href="/admin/manage_user/edit/<%= user._id %>" class="btn btn-warning">แก้ไข</a>
                            </td>
                            <td>
                                <form action="/admin/manage_user/delete/<%= user._id %>" method="POST" class="delete-form" style="display:inline;">
                                    <button type="button" class="btn btn-danger" onclick="confirmDelete(this.form)">ลบ</button>
                                </form>
                            </td>
                        <% } %>
                    </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

    <script>
        function verifySuperAdmin(userId) {
            Swal.fire({
                title: 'ยืนยันตัวตน Super Admin',
                text: 'กรุณากรอกรหัสผ่านเพื่อดำเนินการต่อ',
                input: 'password',
                inputPlaceholder: 'รหัสผ่านของคุณ',
                inputAttributes: { autocapitalize: 'off', autocorrect: 'off' },
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                preConfirm: (password) => {
                    if (!password) {
                        Swal.showValidationMessage('กรุณากรอกรหัสผ่าน');
                        return false;
                    }
                    return fetch('/admin/verify-superadmin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ password })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            Swal.showValidationMessage(data.message || 'รหัสผ่านไม่ถูกต้อง');
                        }
                        return data;
                    })
                    .catch(() => {
                        Swal.showValidationMessage('เกิดข้อผิดพลาดในการตรวจสอบ');
                    });
                }
            }).then((result) => {
                if (result.isConfirmed && result.value.success) {
                    window.location.href = `/admin/manage_user/edit/${userId}`;
                }
            });
        }
         function confirmDelete(form) {
        Swal.fire({
            title: 'คุณต้องการลบใช่ไหม?',
            text: "คุณจะไม่สามารถย้อนกลับได้",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'ใช่, ลบเลย!',
            cancelButtonText: 'ยกเลิก'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    }
    </script>
</body>
</html>
