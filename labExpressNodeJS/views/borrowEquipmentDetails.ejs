<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>รายละเอียดการยืมอุปกรณ์</title>
    <style>
        .img-content {
            display: flex;
            justify-content: center;
        }

        .card-img-top {
            width: 350px;
            height: 300px;
            object-fit: cover;
            border-radius: 22px;
        }

        .status {
            position: absolute;
            top: 15%;
            right: 30%;
        }

        .badge {
            border-radius: 10px 0 0 10px;
        }

        form {
            width: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            margin: 0 auto;
        }

        #rejectSection {
            display: none;
            margin-top: 20px;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        #rejectSection.show {
            display: block;
        }
    </style>
</head>

<body>
    <header class="d-flex">
        <h1> <a href="/admin/Borrowequipment"><i class="bi bi-arrow-left"></i></a> รายละเอียดการยืมอุปกรณ์</h1>
    </header>
    
    <hr>
    <div class="container">
        <div class="img-content my-3">
            <img class="card-img-top" src="/uploads/<%= borrow.equipment_id.image %>" alt="">
            <div class="status">
                <% if (borrow.status==='waiting' ) { %>
                    <p class="badge bg-warning p-3">รอยืนยัน</p>
                <% } else if (borrow.status==='borrowed' ) { %>
                    <p class="badge bg-primary p-3">กำลังยืม</p>
                <% } else if (borrow.status==='returned' ) { %>
                    <p class="badge bg-info p-3">คืนสินค้า</p>
                <% } else if (borrow.status==='rejected' ) { %>
                    <p class="badge bg-danger p-3">ไม่อนุมัติการยืม</p>
                <% } %>
            </div>
        </div>
    </div>

    <form action="/admin/borrow/update/<%= borrow._id %>" method="POST">
        <label><strong>ชื่อ - นามสกุล</strong></label>
        <input type="text" value="<%= borrow.user_id.fname %> <%= borrow.user_id.lname %>" class="form-control"
            readonly>

        <label><strong>ชื่อแปกรณ์</strong></label>
        <input type="text" value="<%= borrow.equipment_id ? borrow.equipment_id.name : 'ไม่มีข้อมูล' %>"
            class="form-control" readonly>

        <div class="mb-3">
            <label for="note" class="form-label"><strong>หมายเหตุ:</strong></label>
            <textarea name="note" id="note" class="form-control" rows="3" readonly><%= borrow.note || '' %></textarea>
        </div>

        <label><strong>วัน-เวลาที่ต้องคืน</strong></label>
        <input type="datetime-local" name="Date" value="<%= new Date(borrow.return_date).toISOString().slice(0,16) %>"
            class="form-control" readonly>
        <input type="hidden" name="status" value="<%= borrow.status %>">

        <input type="submit" class="btn btn-primary my-3" value="อนุมัติการยืม">
        <button type="button" class="btn btn-secondary" onclick="showRejectForm()">ปฏิเสธ</button>
    </form>

    <!-- ฟอร์มปฏิเสธ -->
    <div id="rejectSection">
        <form action="/admin/borrow/reject/<%= borrow._id %>" method="post" id="rejectForm">
            <h5 class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i> เหตุผลในการปฏิเสธ
            </h5>
            
            <div class="mb-3">
                <label for="rejectReason" class="form-label"><strong>กรุณาระบุเหตุผล: <span class="text-danger">*</span></strong></label>
                <textarea 
                    name="rejectReason" 
                    id="rejectReason" 
                    class="form-control" 
                    rows="4" 
                    placeholder="เช่น อุปกรณ์ไม่พร้อมใช้งาน, วันที่ไม่สะดวก, ฯลฯ"
                    required></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger flex-fill">
                    <i class="bi bi-x-circle"></i> ยืนยันปฏิเสธ
                </button>
                <button type="button" class="btn btn-outline-secondary flex-fill" onclick="hideRejectForm()">
                    <i class="bi bi-arrow-left"></i> ยกเลิก
                </button>
            </div>
        </form>
    </div>

    <script>
        function showRejectForm() {
            document.getElementById('rejectSection').classList.add('show');
            // เลื่อนลงมาที่ฟอร์ม
            document.getElementById('rejectSection').scrollIntoView({ behavior: 'smooth' });
        }

        function hideRejectForm() {
            document.getElementById('rejectSection').classList.remove('show');
            // ล้างข้อความที่กรอก
            document.getElementById('rejectReason').value = '';
        }
    </script>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script>
 
  (function() {
    emailjs.init("h-u1QBXnmtRjAUXJ4"); 
  })();

  document.querySelector('form').addEventListener('submit', function(e) {
    e.preventDefault();

    const email = "<%= borrow.user_id.email %>";
    const name = "<%= borrow.user_id.fname %> <%= borrow.user_id.lname %>";
    const equipment_name = "<%= borrow.equipment_id.name %>";
    const equipment_returnDate = new Date("<%= borrow.return_date.toISOString() %>").toLocaleDateString('th-TH', {
      year: 'numeric', month: 'long', day: 'numeric'
    });

    // ส่งอีเมล
    emailjs.send("service_kiij725", "template_0ckrvba", {
      email: email,
      name: name,
      equipment_name: equipment_name,
      equipment_returnDate: equipment_returnDate
    })
    .then(function(response) {
      console.log('SUCCESS!', response.status, response.text);
      alert('ส่งอีเมลเรียบร้อย!');
      // ส่ง form ต่อไปยัง server
      e.target.submit();
    }, function(error) {
      console.log('FAILED...', error);
      alert('ส่งอีเมลไม่สำเร็จ: ' + error.text);
    });
  });
  // ฟอร์มปฏิเสธ
  document.getElementById('rejectForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const email = "<%= borrow.user_id.email %>";
    const name = "<%= borrow.user_id.fname %> <%= borrow.user_id.lname %>";
    const equipment_name = "<%= borrow.equipment_id.name %>";
    const rejectReason = document.getElementById('rejectReason').value;

    console.log('Sending rejection email to:', email);
    console.log('Reject reason:', rejectReason);

    // ส่งอีเมลปฏิเสธ 
    emailjs.send("service_kiij725", "template_a76deel", { 
      email: email,
      name: name,
      equipment_name: equipment_name,
      reject_reason: rejectReason
    })
    .then(function(response) {
      console.log('SUCCESS!', response);
      alert('ส่งอีเมลแจ้งการปฏิเสธเรียบร้อย!');
      e.target.submit();
    })
    .catch(function(error) {
      console.log('FAILED...', error);
      alert('ส่งอีเมลไม่สำเร็จ: ' + error.text);
    });
  });
</script>

</body>

</html>