<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>รายละเอียดการยืมอุปกรณ์</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .img-content {
            display: flex;
            justify-content: center;
        }

        .card-img-top {
            width: 350px;
            height: 300px;
            object-fit: cover;
            border-radius: 22px;

        }

        .status {
            position: absolute;
            top: 15%;
            right: 30%;
        }

        .badge {
            border-radius: 10px 0 0 10px;
        }

        form {
            width: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            margin: 0 auto;
        }
    </style>
</head>

<body>
    <header class="d-flex">
       
    <h1> <a href="/admin/Borrowequipment"><i class="bi bi-arrow-left"></i></a> รายละเอียดการยืมอุปกรณ์</h1>
    </header>
    

    <hr>
    <div class="container">
        <div class="img-content my-3">
            <img class="card-img-top" src="/uploads/<%= borrow.equipment_id.image %>" alt="">
            <div class="status">
                <% if (borrow.status==='waiting' ) { %>
                    <p class="badge bg-warning p-3">รอยืนยัน</p>
                    <% } else if (borrow.status==='borrowed' ) { %>
                        <p class="badge bg-primary p-3">กำลังยืม</p>
                        <% } else if (borrow.status==='returned' ) { %>
                            <p class="badge bg-info p-3">คืนสินค้า</p>
                            <% } else if (borrow.status==='rejected' ) { %>
                                <p class="badge bg-danger p-3">ไม่อนุมัติการยืม</p>
                            <% } %>
            </div>
        </div>
    </div>

    <form action="/admin/borrow/update/<%= borrow._id %>" method="POST">
        <label><strong>ชื่อ - นามสกุล</strong></label>
        <input type="text" value="<%= borrow.user_id.fname %> <%= borrow.user_id.lname %>" class="form-control"
            readonly>

        <label><strong>ชื่ออุปกรณ์</strong></label>
        <input type="text" value="<%= borrow.equipment_id ? borrow.equipment_id.name : 'ไม่มีข้อมูล' %>"
            class="form-control" readonly>

        <div class="mb-3">
            <label for="note" class="form-label"><strong>หมายเหตุ:</strong></label>
            <textarea name="note" id="note" class="form-control" rows="3" readonly><%= borrow.note || '' %></textarea>
        </div>

        <label><strong>วัน-เวลาที่ต้องคืน</strong></label>
        <input type="datetime-local" name="Date" value="<%= new Date(borrow.return_date).toISOString().slice(0,16) %>"
            class="form-control" readonly>
        <input type="hidden" name="status" value="<%= borrow.status %>">

        <input type="submit" class="btn btn-primary my-3" value="อนุมัติการยืม">
        <a href="/admin/borrow/reject/<%= borrow._id %>" class="btn btn-secondary">ปฏิเสธ</a>
    </form>

    </div>
</body>

</html>