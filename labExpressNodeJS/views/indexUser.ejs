<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <style>
        .bg-blue { background-color: #0d6efd !important; }
        .bg-light-blue { background-color: #4a9eff !important; }
        .bg-sky-blue { background-color: #00bcd4 !important; }
        .bg-orange { background-color: #ff9800 !important; }
        .table-blue { --bs-table-bg: #cfe2ff; --bs-table-striped-bg: #b6d4fe; }
    </style>
</head>

<body>
    <div class="container-fluid py-4">
        <% if (user) { %>
            <div class="row mb-4">
                <div class="col-12">
                    <h1 class="display-5 fw-bold text-blue">สวัสดี คุณ <%= user.fname %> <%= user.lname %></h1>
                    <hr class="my-3">
                </div>
            </div>

            <!-- รายการอุปกรณ์ที่ต้องคืน -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="card shadow-sm border-info">
                        <div class="card-header bg-light-blue text-white">
                            <h3 class="mb-0"><i class="bi bi-check-circle me-2"></i>รายการที่ต้องคืน</h3>
                        </div>
                        <div class="card-body">
                            <% const borrowedItems = borrows && borrows.length ? borrows.filter(b => b.status === 'borrowed') : []; %>
                            <% if (borrowedItems.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped align-middle">
                                        <thead class="bg-sky-blue text-white">
                                            <tr>
                                                <th class="text-center">ลำดับ</th>
                                                <th>ชื่ออุปกรณ์</th>
                                                <th class="text-center">วันที่ยืม</th>
                                                <th class="text-center">วันที่ต้องคืน</th>
                                                <th>หมายเหตุ</th>
                                                <th class="text-center">สถานะ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% borrowedItems.forEach((borrow, index) => { %>
                                                <tr>
                                                    <td class="text-center"><%= index + 1 %></td>
                                                    <td><strong><%= borrow.equipment_id ? borrow.equipment_id.name : '-' %></strong></td>
                                                    <td class="text-center"><%= borrow.created_at ? new Date(borrow.created_at).toLocaleDateString('th-TH') : '-' %></td>
                                                    <td class="text-center"><%= borrow.return_date ? new Date(borrow.return_date).toLocaleDateString('th-TH') : '-' %></td>
                                                    <td><%= borrow.note || '-' %></td>
                                                    <td class="text-center"><span class="badge bg-sky-blue text-white">กำลังยืม</span></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="alert alert-primary text-center">
                                    <i class="bi bi-info-circle me-2"></i>ยังไม่มีอุปกรณ์ที่ยืม
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- รายการแจ้งซ่อม -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="card shadow-sm border-warning">
                        <div class="card-header bg-orange text-white d-flex justify-content-between align-items-center">
                            <h3 class="mb-0"><i class="bi bi-tools me-2"></i>รายการแจ้งซ่อม</h3>
                            <a href="/users/repair" class="btn btn-warning"><i class="bi bi-plus-circle me-1"></i> แจ้งซ่อมใหม่</a>
                        </div>
                        <div class="card-body">
                            <!-- ฟิลเตอร์ค้นหา -->
                            <div class="row mb-3">
                                <div class="col-md-4 mb-2">
                                    <input type="text" id="repairSearch" class="form-control" placeholder="ค้นหาอุปกรณ์...">
                                </div>
                                <div class="col-md-4 mb-2">
                                    <select id="repairMonth" class="form-select">
                                        <option value="">ทั้งหมด (เดือน)</option>
                                        <% for (let m = 1; m <= 12; m++) { %>
                                            <option value="<%= m.toString() %>"><%= m %></option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <select id="repairStatus" class="form-select">
                                        <option value="">ทั้งหมด (สถานะ)</option>
                                        <option value="รอดำเนินการ">รอดำเนินการ</option>
                                        <option value="กำลังดำเนินการ">กำลังดำเนินการ</option>
                                        <option value="เสร็จสิ้น">เสร็จสิ้น</option>
                                        <option value="ยกเลิก">ยกเลิก</option>
                                    </select>
                                </div>
                            </div>

                            <% const repairItems = repairs || []; %>
                            <% if (repairItems.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped align-middle">
                                        <thead class="bg-warning text-white">
                                            <tr>
                                                <th class="text-center">ลำดับ</th>
                                                <th>ชื่ออุปกรณ์</th>
                                                <th>รายละเอียด</th>
                                                <th class="text-center">วันที่แจ้ง</th>
                                                <th class="text-center">สถานะ</th>
                                                <th class="text-center">จัดการ</th>
                                            </tr>
                                        </thead>
                                        <tbody id="repairTableBody">
                                            <% repairItems.forEach((repair, index) => { %>
                                                <% 
                                                    let statusBadge = "", statusTextTH = "";
                                                    switch(repair.status){
                                                        case 'pending': case 'รอดำเนินการ':
                                                            statusBadge = '<span class="badge bg-info text-white">รอดำเนินการ</span>';
                                                            statusTextTH = 'รอดำเนินการ';
                                                            break;
                                                        case 'in_progress': case 'กำลังดำเนินการ':
                                                            statusBadge = '<span class="badge bg-primary text-white">กำลังดำเนินการ</span>';
                                                            statusTextTH = 'กำลังดำเนินการ';
                                                            break;
                                                        case 'done': case 'completed': case 'เสร็จสิ้น':
                                                            statusBadge = '<span class="badge bg-success text-white">เสร็จสิ้น</span>';
                                                            statusTextTH = 'เสร็จสิ้น';
                                                            break;
                                                        case 'cancel': case 'rejected': case 'ยกเลิก':
                                                            statusBadge = '<span class="badge bg-danger text-white">ยกเลิก</span>';
                                                            statusTextTH = 'ยกเลิก';
                                                            break;
                                                        default:
                                                            statusBadge = '<span class="badge bg-secondary text-dark">'+repair.status+'</span>';
                                                            statusTextTH = repair.status;
                                                            break;
                                                    }
                                                %>
                                                <tr data-month="<%= repair.created_at ? (new Date(repair.created_at).getMonth()+1).toString() : '' %>"
                                                    data-status="<%= repair.status %>">
                                                    <td class="text-center"><%= index + 1 %></td>
                                                    <td><strong><%= repair.equipment_id ? repair.equipment_id.name : '-' %></strong></td>
                                                    <td><%= repair.type || repair.issue_description || '-' %></td>
                                                    <td class="text-center"><%= repair.created_at ? new Date(repair.created_at).toLocaleDateString('th-TH') : '-' %></td>
                                                    <td class="text-center"><%- statusBadge %></td>
                                                    <td class="text-center">
                                                        <button class="btn btn-sm btn-outline-primary"
                                                            onclick="showRepairDetail('<%= repair.equipment_id ? repair.equipment_id.name : '-' %>', '<%= repair.type || repair.issue_description || '-' %>', '<%= statusTextTH %>')">
                                                            <i class="bi bi-eye"></i> ดูรายละเอียด
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="alert alert-warning text-center">
                                    <i class="bi bi-info-circle me-2"></i>ยังไม่มีรายการแจ้งซ่อม
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="alert alert-danger text-center">
                <i class="bi bi-exclamation-triangle me-2"></i>ไม่พบข้อมูลผู้ใช้
            </div>
        <% } %>
    </div>

    <!-- Filter Script -->
    <script>
        const searchInput = document.getElementById('repairSearch');
        const monthSelect = document.getElementById('repairMonth');
        const statusSelect = document.getElementById('repairStatus');
        const tableBody = document.getElementById('repairTableBody');
        const rows = tableBody ? Array.from(tableBody.getElementsByTagName('tr')) : [];

        const statusMap = {
            "pending": "รอดำเนินการ",
            "in_progress": "กำลังดำเนินการ",
            "done": "เสร็จสิ้น",
            "completed": "เสร็จสิ้น",
            "cancel": "ยกเลิก",
            "rejected": "ยกเลิก",
            "รอดำเนินการ": "รอดำเนินการ",
            "กำลังดำเนินการ": "กำลังดำเนินการ",
            "เสร็จสิ้น": "เสร็จสิ้น",
            "ยกเลิก": "ยกเลิก"
        };

        function filterRepairs() {
            const searchText = searchInput.value.toLowerCase();
            const selectedMonth = monthSelect.value;
            const selectedStatus = statusSelect.value;

            rows.forEach(row => {
                const name = row.cells[1].innerText.toLowerCase();
                const rowMonth = row.dataset.month;
                const rowStatus = statusMap[row.dataset.status] || row.dataset.status;

                const matchText = name.includes(searchText);
                const matchMonth = !selectedMonth || rowMonth === selectedMonth;
                const matchStatus = !selectedStatus || rowStatus === selectedStatus;

                row.style.display = (matchText && matchMonth && matchStatus) ? '' : 'none';
            });
        }

        if (searchInput) searchInput.addEventListener('input', filterRepairs);
        if (monthSelect) monthSelect.addEventListener('change', filterRepairs);
        if (statusSelect) statusSelect.addEventListener('change', filterRepairs);

        // SweetAlert2 สำหรับดูรายละเอียด
        function showRepairDetail(name, description, status) {
            Swal.fire({
                title: `<strong>รายละเอียดการแจ้งซ่อม</strong>`,
                html: `
                    <p><strong>ชื่ออุปกรณ์:</strong> ${name}</p>
                    <p><strong>รายละเอียด:</strong> ${description}</p>
                    <p><strong>สถานะ:</strong> ${status}</p>
                `,
                icon: 'info',
                confirmButtonText: 'ปิด',
                confirmButtonColor: '#0d6efd'
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>

</html>
