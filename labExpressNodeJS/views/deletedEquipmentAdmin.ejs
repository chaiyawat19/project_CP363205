<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <div class="container mt-4">
        <header class="d-flex align-items-center justify-content-between mb-4">
            <div class="box">
                <div class="col-12 mb-3">
                    <a href="/admin/listitemuser" class="btn btn-dark">กลับ</a>
                </div>
                 <h1> 
                    รายการอุปกรณ์ที่ถูกลบ
                </h1>
            </div>
            <div class="box2 d-flex align-items-center">
                 <button type="button" class="btn btn-danger px-4 py-2" 
                    onclick="confirmDeleteAllPermanently()">
                    <i class="fas fa-trash-alt"></i> ลบถาวรทั้งหมด
                </button>
            </div>
        </header>
        <hr>
        <% if (deletedEquipmentList.length===0) { %>
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> ไม่มีอุปกรณ์ในถังขยะ
            </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ลำดับ</th>
                                <th>รูปภาพ</th>
                                <th>ชื่ออุปกรณ์</th>
                                <th>หมวดหมู่</th>
                                <th>สถานที่เก็บ</th>
                                <th>วันที่ลบ</th>
                                <th>จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% deletedEquipmentList.forEach((equipment, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <% if (equipment.image) { %>
                                            <img src="/uploads/<%= equipment.image %>" alt="<%= equipment.name %>"
                                                style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                                            <% } else { %>
                                                <img src="https://via.placeholder.com/60" alt="No Image"
                                                    style="border-radius: 5px;">
                                                <% } %>
                                    </td>
                                    <td>
                                        <%= equipment.name %>
                                    </td>
                                    <td>
                                        <%= equipment.category_id ? equipment.category_id.name : 'ไม่มีหมวดหมู่' %>
                                    </td>
                                    <td>
                                        <%= equipment.location || '-' %>
                                    </td>
                                    <td>
                                        <%= equipment.deleted_at ? new
                                            Date(equipment.deleted_at).toLocaleDateString('th-TH') : '-' %>
                                    </td>
                                    <td>
                                        <!-- ปุ่มกู้คืน -->
                                        <form action="/admin/restoreEquipment/<%= equipment._id %>" method="POST"
                                            class="d-inline" id="restore-form-<%= equipment._id %>">
                                            <button type="button" class="btn btn-success btn-sm"
                                                onclick="confirmRestore(event, '<%= equipment._id %>', '<%= equipment.name %>')">
                                                <i class="fas fa-undo"></i> กู้คืน
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } %>
    </div>

    <script>
        // ฟังก์ชันยืนยันการกู้คืน
        function confirmRestore(event, equipmentId, equipmentName) {
            event.preventDefault();

            Swal.fire({
                title: "ต้องการกู้คืนอุปกรณ์นี้หรือไม่?",
                text: `อุปกรณ์: ${equipmentName}`,
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#28a745",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "ยืนยันการกู้คืน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('restore-form-' + equipmentId);

                    if (form) {
                        Swal.fire({
                            title: "กำลังกู้คืนอุปกรณ์...",
                            text: "กรุณารอสักครู่",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 800
                        });

                        setTimeout(() => {
                            form.submit();
                        }, 800);
                    } else {
                        Swal.fire({
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่พบฟอร์มสำหรับกู้คืนอุปกรณ์',
                            icon: 'error'
                        });
                    }
                }
            });
        }
        function confirmDeleteAllPermanently() {
    Swal.fire({
        title: "ยืนยันการลบถาวร?",
        text: "การกระทำนี้จะลบอุปกรณ์ทั้งหมดในถังขยะออกจากระบบถาวร ไม่สามารถกู้คืนได้",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "ใช่ ลบถาวร",
        cancelButtonText: "ยกเลิก",
        allowOutsideClick: false,
        allowEscapeKey: false
    }).then((result) => {
        if (result.isConfirmed) {
            // แสดง confirmation ครั้งที่ 2 (double confirmation)
            Swal.fire({
                title: "คุณแน่ใจหรือ?",
                text: "นี่คือการแจ้งเตือนครั้งสุดท้าย - ข้อมูลจะถูกลบถาวร",
                icon: "error",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "ลบถาวรเลย",
                cancelButtonText: "ยกเลิก"
            }).then((finalResult) => {
                if (finalResult.isConfirmed) {
                    deleteAllPermanently();
                }
            });
        }
    });
}

// ฟังก์ชันลบอุปกรณ์ทั้งหมดถาวร
function deleteAllPermanently() {
    Swal.fire({
        title: "กำลังลบข้อมูล...",
        text: "กรุณารอสักครู่",
        icon: "info",
        showConfirmButton: false,
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    fetch("/admin/deleteallapermanently", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            Swal.fire({
                title: "ลบสำเร็จ!",
                text: `ลบอุปกรณ์ ${data.deletedCount} รายการออกจากระบบแล้ว`,
                icon: "success",
                confirmButtonText: "ตกลง"
            }).then(() => {
                location.reload();
            });
        } else {
            Swal.fire({
                title: "เกิดข้อผิดพลาด",
                text: data.message || "ไม่สามารถลบข้อมูลได้",
                icon: "error"
            });
        }
    })
    .catch(error => {
        console.error("Error:", error);
        Swal.fire({
            title: "เกิดข้อผิดพลาด",
            text: "ไม่สามารถติดต่อกับเซิร์ฟเวอร์",
            icon: "error"
        });
    });
}

    </script>
</body>

</html>