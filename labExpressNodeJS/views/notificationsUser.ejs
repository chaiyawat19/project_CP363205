
<div class="container">
    <h1 class="mt-4"><%= title %> (<%= name %>)</h1>
    <p>Active Page: <%= activePage %></p>

    <div class="notification-list mt-4">
        <% if (notifications && notifications.length > 0) { %>
            <h2>รายการแจ้งเตือน</h2>
            
            <% notifications.forEach(function(notification) { %>
                <div class="card mb-3 <%= notification.read ? 'bg-light' : 'bg-warning-subtle' %>">
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= notification.title %>
                            <% if (!notification.read) { %>
                                <span class="badge bg-danger ms-2">ใหม่!</span>
                            <% } %>
                        </h5>
                        <p class="card-text"><%= notification.message %></p>
                        <p class="card-text">
                            <small class="text-muted">
                                วันที่: <%= notification.createdAt.toLocaleDateString() %> 
                                เวลา: <%= notification.createdAt.toLocaleTimeString() %>
                            </small>
                        </p>
                        <p><%= notification.isRead%></p>
                        <form action="/admin/notification/mark-read/<%= notification._id %>" method="post">
                            <button type="submit" class="btn btn-sm btn-primary">
                                ทำเครื่องหมายว่าอ่านแล้ว
                            </button>
                        </form>
                        </div>
                         
                </div>
               
            <% }); %>

        <% } else { %>
            <div class="alert alert-info" role="alert">
                <p>⚠️ ไม่มีการแจ้งเตือนในขณะนี้</p>
            </div>
        <% } %>
    </div>
</div>