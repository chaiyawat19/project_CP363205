<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
</head>

<body class="bg-light">
  <div class="container mt-4">
    <h1 class="mb-3">รายการอุปกรณ์</h1>
    <p class="text-muted">อุปกรณ์ทั้งหมดในบริษัท</p>
    
    <div class="mb-4 d-flex" style="gap: 10px;">
      <input type="text" id="searchInput" class="form-control" placeholder="🔍 ค้นหาชื่ออุปกรณ์...">
      <button type="button" id="clearSearch" class="btn btn-secondary">รีเซ็ต</button>
    </div>

    <div class="row" id="equipmentList">
      <% equipments.forEach(function(item) { %>
        <div class="col-md-3 mb-4 equipment-card">
          <div class="card h-100 shadow-sm d-flex flex-column">
            <% if(item.image) { %>
              <img src="/uploads/<%= item.image %>" class="card-img-top" alt="<%= item.name %>"
                style="object-fit: contain; height: 200px;" />
            <% } else { %>
              <img src="https://via.placeholder.com/300x200?text=No+Image" class="card-img-top" alt="No image"
                style="height: 200px;" />
            <% } %>

            <div class="card-body d-flex flex-column">
              <h5 class="card-title equipment-name"><%= item.name %></h5>
              <div class="flex-grow-1">
                <p class="card-text">
                  <strong>หมวดหมู่:</strong>
                  <%= item.category_id ? item.category_id.name : 'ไม่มีหมวดหมู่' %><br />
                  <strong>รายละเอียด:</strong> <%= item.description %><br />
                  <strong>สถานะ:</strong>
                  <% if(item.status === "available") { %>
                    <span class="badge bg-success">พร้อมใช้งาน</span>
                  <% } else { %>
                    <span class="badge bg-danger">ไม่พร้อมใช้งาน</span>
                  <% } %><br />
                  <strong>ตำแหน่ง:</strong> <%= item.location %>
                </p>
              </div>
              <div class="mt-auto">
                <% if (item.status === "available") { %>
                  <a class="btn btn-primary w-100 mt-3" href="/users/equipments/<%= item.id %>">
                    ยืมอุปกรณ์
                  </a>
                <% } else { %>
                  <button class="btn btn-secondary w-100 mt-3" disabled>
                    ไม่พร้อมใช้งาน
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const searchInput = document.getElementById('searchInput');
      const clearSearch = document.getElementById('clearSearch');
      const cards = document.querySelectorAll('.equipment-card');

      searchInput.addEventListener('keyup', function () {
        const filter = searchInput.value.toLowerCase();

        cards.forEach(card => {
          const name = card.querySelector('.equipment-name').textContent.toLowerCase();
          card.style.display = name.includes(filter) ? '' : 'none';
        });
      });

      clearSearch.addEventListener('click', function () {
        searchInput.value = '';
        cards.forEach(card => card.style.display = '');
      });
    });
  </script>
</body>

</html>
