<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      box-sizing: border-box;
      background: #F3F4F6;
      font-family: "Kanit", sans-serif;
    }
    .login{
      background-color: white;
      padding: 10px;
      height: 100vh;
      display: flex;
      justify-content: center;
      flex-direction: column;
    }
    .container-fluid{
      padding: 0;
      
    }
    form {
      display: flex;
      justify-content: center;
      flex-direction: column;
      width: 450px;
      padding: 25px;
      box-sizing: border-box;
      
    }
    form input {
      border: 1px solid #ccc;
      padding: 10px;
      border-radius: 15px;
    }
    form input[type="submit"] {
      border: none;
      padding: 12px;
      border-radius: 15px;
      margin-top: 15px;
      background-color: #003F8F;
      color: white;
      font-weight: 500;
      cursor: pointer;
      transition: 0.3s;
    }
    .box{
      display: flex;
      flex-direction: column;
    }
    .box input[type="text"] {
      width: 100%;
    }
    form input[type="submit"]:hover {
      background-color: #0053c0;
    }
    form input:focus {
      border: 1px solid #003F8F;
      outline: none;
    }
    form label {
      margin: 10px 0 5px;
    }
    .login h1 {
      text-align: center;
      color: #003F8F;
      margin-bottom: 20px;
    }
    .img{
      width: 100%;
      height: 100vh;
      
    }
    .img img{
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .logo{
      text-align: center;
    }
    .logo h1{
      text-align: center;
      color: #003F8F;
      margin: 0;
    }
    .register{
      display: flex;
      justify-content: center;
      margin: 10px 0;
    }
    .register p{
      margin: 0px 10px;
    }
    .fullname{
      display: flex;
    }
    .or{
      margin: 0 10px;
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="img">
      <img src="https://cdn.discordapp.com/attachments/1416380695118352455/1426176418949238936/Sure_Please_provide_the_text_youd_like_me_to_paraphrase_and_Ill_assist_you_with_that_.jpg?ex=68ea45cb&is=68e8f44b&hm=ac98dd9b6185be6641940185d440e98ca2009a4cea5febbffacaf39274df0b74&" alt="">
    </div>
    <div class="login">
      <form action="/register" method="POST">
        <div class="logo">
          <h1>สมัครสมาชิก</h1>
          <small>บริการระบบยืมและคืนอุปกรณ์ภายในบริษัท</small>
        </div>
        <div class="fullname">
          <div class="box">
            <label for="fname" class="">ชื่อ</label>
            <input type="text" class="" id="fname" name="fname" placeholder="กรุณากรอกชื่อจริง" required />
          </div>
          <div class="or"></div>
          <div class="box">
            <label for="lname" class="">นามสกุล</label>
            <input type="text" class="" id="lname" name="lname" placeholder="กรุณากรอกนามสกุล" required />
          </div>
        </div>
        
        <label for="email" class="">อีเมล</label>
        <input type="email" class="" id="email" name="email" placeholder="example@company.com" required />
        <label for="password">รหัสผ่าน</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required />
        <label for="confirmPassword" class="">ยืนยันรหัสผ่าน</label>
        <input type="password" class="" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required />

        <input type="submit" value="สมัครสมาชิก">
        <div class="register">
          <p>ยังมีบัญชี? </p><a href="/login"> เข้าสู่ระบบ</a>
        </div>
        
      </form>
    </div>
  </div>
