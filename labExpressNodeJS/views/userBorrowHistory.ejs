
<%
    // ตัวช่วยฟังก์ชันสำหรับแสดงสถานะ (ใช้สี Bootstrap)
    const getStatusBadge = (status) => {
        switch (status) {
            case 'waiting':
                return '<span class="badge bg-warning text-dark">รอยืนยัน</span>';
            case 'borrowed':
                return '<span class="badge bg-primary">กำลังยืม</span>';
            case 'returned':
                return '<span class="badge bg-success">คืนแล้ว</span>';
            case 'rejected':
                return '<span class="badge bg-danger">ถูกปฏิเสธ</span>';
            default:
                return `<span class="badge bg-secondary">${status}</span>`;
        }
    };
%>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">ประวัติการยืมอุปกรณ์ของฉัน</h2>
    </div>

    <div class="card shadow-sm p-4">
        
        <% if (borrows && borrows.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">อุปกรณ์</th>
                            <th scope="col">วันที่กำหนดคืน</th>
                            <th scope="col">สถานะ</th>
                            <th scope="col">หมายเหตุ</th>
                            <th scope="col">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% borrows.forEach((borrow, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td>
                                    <strong><%= borrow.equipment_id ? borrow.equipment_id.name : 'ไม่พบอุปกรณ์' %></strong>
                                </td>
                                <td><%= new Date(borrow.return_date).toLocaleDateString('th-TH') %></td>
                                <td>
                                    <%- getStatusBadge(borrow.status) %>
                                </td>
                                <td><%= borrow.note %></td>
                                <td>
                                    <% if (borrow.status === 'borrowed') { %>
                                        <form action="/users/return/<%= borrow._id %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-success">คืนอุปกรณ์</button>
                                        </form>
                                    <% } else if (borrow.status === 'pending') { %>
                                        <button class="btn btn-sm btn-info disabled">รออนุมัติ</button>
                                    <% } else { %>
                                        <a href="/users/borrow/detail/<%= borrow._id %>" class="btn btn-sm btn-secondary">ดูรายละเอียด</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info mb-0" role="alert">
                คุณยังไม่มีประวัติการยืมอุปกรณ์
            </div>
        <% } %>

    </div>
</div>