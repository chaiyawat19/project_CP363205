<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบยืม-คืนอุปกรณ์</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');

        body {
            box-sizing: border-box;
            background: #F3F4F6;
            font-family: "Kanit", sans-serif;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
        }

        ul.menu,
        ul.menu-center {
            display: flex;
            align-items: center;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        ul.menu li,
        ul.menu-center li {
            margin: 0 10px;
        }

        ul.menu-center a {
            text-decoration: none;
            padding: 10px;
            color: #111111;
        }

        ul.menu a {
            text-decoration: none;
            padding: 10px;
            background-color: #111111;
            color: white;
            border-radius: 15px;
        }

        .box {
            position: absolute;
            z-index: -100;
            top: 12%;
            left: 65%;
            font-size: 24px;
        }

        .box h1 {
            font-size: 100px;
        }

        .content {
            display: flex;
            justify-content: center;
        }

        @keyframes float {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-20px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        .floating-image {
            animation: float 3s ease-in-out infinite;
        }

        .logo {
            width: 70px;
            height: 70px;
            overflow: hidden;
        }

        .logo img {
            width: 120px;
            object-fit: cover;
            transform: translate(-25px, -25px);
        }

        .card {
            box-shadow: #111111 -5px 5px 0px;
            transition: all 0.3s ease; 
        }
        .card:hover{
            transform: translateY(-5px); 
            box-shadow: #111111 -8px 8px 0px;  
        }
        footer{
            background-color: #111111;
            color: white;
        }
        .card-img-css{
            overflow: hidden;

        }
        .card-img-css img{
            
            transform: translate(-1000px,0);
        }
        .card-img-css3{
            overflow: hidden;
             height: 180px;

        }
        .card-img-css3 img{
            width: 1000px;
            transform: translate(-350px,-220px);
        }
        .card-img-css2{
            overflow: hidden;
            height: 195px;
            overflow: hidden;

        }
        .card-img-css2 img{
            transform: translate(-100px,-123px);
          
        }

        .counter-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #111111;
        }
    </style>
</head>

<body>
    <div class="container-fluid p-0">
        <nav>
            <div class="logo">
                <img src="../uploads/img/logo.png" alt="">
            </div>
            <ul class="menu-center">
               
            </ul>
            <ul class="menu">
                <li><a href="/login">เข้าสู่ระบบ</a></li>
                <li><a href="/register">สมัครสมาชิก</a></li>
            </ul>
        </nav>
        <div class="container" >
            <div class="content" data-aos="fade-up">
                <img class="floating-image"
                    src="../uploads/img/index.png"
                    alt="" width="720px">
                <div class="box">
                    <h1>AssetFlow</h1>
                    <p class="text-end">บริการระบบยืมและคืนอุปกรณ์ภายในบริษัท</p>
                </div>
            </div>
        </div>
        <div class="container my-3" >
            <div class="row" data-aos="fade-up">
                <div class="col-4">
                    <div class="card p-2">
                        <div class="card-bod">
                            <h5 class="card-title">ผู้ใช้งานเว็บไซต์</h5>
                            <p class="card-text counter-number" data-target="<%= userCount %>">0</p>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card p-2">
                        <div class="card-bod">
                            <h5 class="card-title">จำนวนอุปกรณ์ในเว็บ</h5>
                            <p class="card-text counter-number" data-target="<%= equipmentCount %>">0</p>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card p-2">
                        <div class="card-bod">
                            <h5 class="card-title">จำนวนการยืมทั้งหมด</h5>
                            <p class="card-text counter-number" data-target="<%= borrowCount %>">0</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container my-3" >
            <div class="row" data-aos="fade-up">
                <div class="col-6">
                    <div class="card p-2">
                        <div class="card-img-css">
                           <img src="uploads/img/1753156312.jpg" alt="">
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="col-12">
                         <div class="card">
                        <div class="card-img-css2 card-img">
                           <img src="../uploads/img/d2.jfif" alt="">
                        </div>
                    </div>
                    <div class="col-12 mt-3">
                         <div class="card p-0">
                        <div class="card-img-css3 card-img">
                           <img src="uploads/img/cr2.jfif" alt="">
                        </div>
                    </div>
                    </div>  
                </div>
            </div>
        </div>
    </div>
    <footer class="mt-auto p-3" data-aos="fade-up">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <h5>AssetFlow</h5>
                        <p>บริการระบบยืมและคืนอุปกรณ์ภายในบริษัท เป็นระบบที่พัฒนาขึ้นเพื่อจัดการกระบวนการยืมและคืนอุปกรณ์ที่ใช้ในการทำงานภายในองค์กร เช่น คอมพิวเตอร์โน้ตบุ๊ก โปรเจกเตอร์ กล้อง เครื่องมือช่าง หรืออุปกรณ์สำนักงานต่าง ๆ โดยมีวัตถุประสงค์เพื่อให้การจัดการอุปกรณ์เป็นระบบ ระเบียบ และตรวจสอบได้ง่ายขึ้น</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Quick Links</h5>
                        <ul class="list-unstyled">
                            <li><a href="#" class="text-decoration-none text-white">Home</a></li>
                            <li><a href="#" class="text-decoration-none text-white">Services</a></li>
                            <li><a href="#" class="text-decoration-none text-white">Contact</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Follow Us</h5>
                        <ul class="list-inline social-icons">
                            <li class="list-inline-item"><a href="#" class="text-white"><i
                                        class="bi bi-facebook"></i></a></li>
                            <li class="list-inline-item"><a href="#" class="text-white"><i
                                        class="bi bi-twitter"></i></a></li>
                            <li class="list-inline-item"><a href="#" class="text-white"><i
                                        class="bi bi-instagram"></i></a></li>
                        </ul>
                    </div>
                </div>
                <hr class="mb-4">
                <div class="row">
                    <div class="col-md-12 text-center">
                        <p>&copy; 2025 AssetFlow Company. All rights reserved.</p>
                    </div>
                </div>
            </div>
        </footer>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();
        function animateCounter() {
            const counters = document.querySelectorAll('.counter-number');
            
            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-target'));
                let current = 0;
                const increment = target / 100;
                const speed = 30;
                
                const updateCounter = () => {
                    current += increment;
                    if (current < target) {
                        counter.textContent = Math.floor(current).toLocaleString('th-TH');
                        setTimeout(updateCounter, speed);
                    } else {
                        counter.textContent = target.toLocaleString('th-TH');
                    }
                };
                
                updateCounter();
            });
        }
        window.addEventListener('load', () => {
            setTimeout(animateCounter, 500);
        });
    </script>
</body>

</html>