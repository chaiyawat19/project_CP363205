<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    .field-label { 
      font-weight: normal; color: #555; 
    }
    .field-value { 
      font-weight: bold; color: #222; 
    }

    .equip-img { 
      max-height: 250px; object-fit: contain; display: block; margin-top: 0.5rem; 
    }
    .card { 
      border-radius: 10px; 
    }

    .btn-status { 
      margin: 2px; 
    }
    .btn-status:hover {
      opacity: 0.85;
      transition: 0.2s;
    }

    .btn-status[data-status="pending"].active { background-color: #f0ad4e; color: #fff; border-color: #f0ad4e; }
    .btn-status[data-status="in_progress"].active { background-color: #17a2b8; color: #fff; border-color: #17a2b8; }
    .btn-status[data-status="completed"].active { background-color: #28a745; color: #fff; border-color: #28a745; }
    .btn-status[data-status="rejected"].active { background-color: #dc3545; color: #fff; border-color: #dc3545; }

    .badge-pending { background:#f0ad4e; color:#fff; }
    .badge-inprogress { background:#17a2b8; color:#fff; }
    .badge-completed { background:#28a745; color:#fff; }
    .badge-rejected { background:#dc3545; color:#fff; }
  </style>
</head>
<body>
  <div class="container-fluid p-0">
    <h1 class="mb-4">รายละเอียดคำร้องซ่อม (Admin)</h1>

    <div class="row">
      <!-- ข้อมูลผู้แจ้งและอุปกรณ์ -->
      <div class="col-lg-6">
        <div class="card mb-3 shadow-sm">
          <div class="card-body">
            <p><span class="field-label">ผู้แจ้ง:</span> <span class="field-value"><%= (item.user_id && item.user_id.fname && item.user_id.lname) ? item.user_id.fname + ' ' + item.user_id.lname : (item.user_id || '-') %></span></p>
            <% if (item.user_id && item.user_id.phone) { %>
              <p><span class="field-label">เบอร์โทร:</span> <span class="field-value"><%= item.user_id.phone %></span></p>
            <% } %>
            <p><span class="field-label">อุปกรณ์:</span> <span class="field-value"><%= item.equipment_id && item.equipment_id.name ? item.equipment_id.name : (item.equipment_id || '-') %></span></p>
            <% if (item.equipment_id && item.equipment_id.location) { %>
              <p><span class="field-label">สถานที่:</span> <span class="field-value"><%= item.equipment_id.location %></span></p>
            <% } %>
            <p><span class="field-label">คำอธิบาย:</span> <span class="field-value"><%= item.issue_description || '-' %></span></p>
            <p><span class="field-label">วันที่แจ้ง:</span> <span class="field-value"><%= typeof formatThaiDate === 'function' ? formatThaiDate(item.created_at) : item.created_at %></span></p>

            <% if (item.equipment_id && item.equipment_id.image) { %>
              <p class="mt-3"><span class="field-label">รูปอุปกรณ์:</span></p>
              <img src="/uploads/<%= item.equipment_id.image %>" alt="image" class="equip-img img-fluid rounded shadow-sm">
            <% } %>
          </div>
        </div>
      </div>

      <!-- ฟอร์มตอบกลับและสถานะ -->
      <div class="col-lg-6">
        <div class="card mb-3 shadow-sm">
          <div class="card-body">
            <form id="adminReplyForm" action="/admin/reqair_requests_detailadmin/<%= item._id %>/reply" method="post">
              <div class="mb-3">
                <label class="form-label field-label">คอมเมนต์แอดมิน</label>
                <textarea name="admin_comment" class="form-control" rows="4" placeholder="เขียนข้อความตอบกลับผู้แจ้ง..."><%= item.admin_comment || '' %></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label field-label d-block mb-2">สถานะ</label>
                <div class="btn-group btn-group-toggle d-flex flex-wrap" role="group">
                  <button type="button" class="btn btn-outline-secondary btn-status" data-status="pending">Pending</button>
                  <button type="button" class="btn btn-outline-secondary btn-status" data-status="in_progress">In Progress</button>
                  <button type="button" class="btn btn-outline-secondary btn-status" data-status="completed">Completed</button>
                  <button type="button" class="btn btn-outline-secondary btn-status" data-status="rejected">Rejected</button>
                </div>
                <input type="hidden" name="status" id="statusInput" value="<%= item.status %>">
              </div>

              <div class="mb-3">
                <label class="form-label field-label">วันที่ซ่อมเสร็จ (เลือกถ้าต้องการ)</label>
                <input type="date" name="completion_date" class="form-control" value="<%= item.completion_date ? new Date(item.completion_date).toISOString().slice(0,10) : '' %>">
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">ตอบกลับและบันทึก</button>
                <a href="/admin/reqair_requestsadmin" class="btn btn-secondary">กลับ</a>
              </div>
            </form>
          </div>
        </div>

        <!-- สถานะปัจจุบันและคอมเมนต์ล่าสุด -->
        <div class="card shadow-sm">
          <div class="card-body">
            <p class="field-label mb-1">สถานะปัจจุบัน</p>
            <p><span class="badge <%= item.status === 'pending' ? 'badge-pending' : item.status === 'in_progress' ? 'badge-inprogress' : item.status === 'completed' ? 'badge-completed' : 'badge-rejected' %>"><%= item.status %></span></p>

            <p class="field-label mb-1 mt-3">คอมเมนต์ล่าสุด</p>
            <p><span class="field-value"><%= item.admin_comment || '-' %></span></p>

            <p class="field-label mb-1 mt-3">วันที่ซ่อมเสร็จ</p>
            <p><span class="field-value"><%= item.completion_date ? (typeof formatThaiDate === 'function' ? formatThaiDate(item.completion_date) : item.completion_date) : '-' %></span></p>

            <p class="text-muted small mt-3">แก้ไขล่าสุด: <%= typeof formatThaiDate === 'function' ? formatThaiDate(item.updated_at) : item.updated_at %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
  const statusButtons = document.querySelectorAll('.btn-status');
  const statusInput = document.getElementById('statusInput');

  statusButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // ลบ active จากปุ่มอื่นทั้งหมด
      statusButtons.forEach(b => b.classList.remove('active'));
      // เพิ่ม active ให้ปุ่มที่กด
      btn.classList.add('active');
      // เซ็ตค่า hidden input
      statusInput.value = btn.dataset.status;
    });

    // กำหนด active ตามค่าเดิมตอนโหลดหน้า
    if(btn.dataset.status === statusInput.value){
      btn.classList.add('active');
    }
  });
  </script>
</body>
</html>
