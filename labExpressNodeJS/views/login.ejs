<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    body {
      box-sizing: border-box;
      background: #F3F4F6;
      font-family: "Kanit", sans-serif;
    }
    .login{
      background-color: white;
      padding: 10px;
      height: 100vh;
      display: flex;
      justify-content: center;
      flex-direction: column;
    }
    .container-fluid{
      padding: 0;
      
    }
    form {
      display: flex;
      justify-content: center;
      flex-direction: column;
      width: 450px;
      padding: 25px;
      
    }
    form input {
      border: 1px solid #ccc;
      padding: 10px;
      border-radius: 15px;
    }
    form input[type="submit"] {
      border: none;
      padding: 12px;
      border-radius: 15px;
      margin-top: 15px;
      background-color: #003F8F;
      color: white;
      font-weight: 500;
      cursor: pointer;
      transition: 0.3s;
    }
    form input[type="submit"]:hover {
      background-color: #0053c0;
    }
    form input:focus {
      border: 1px solid #003F8F;
      outline: none;
    }
    form label {
      margin: 10px 0 5px;
    }
    .login h1 {
      text-align: center;
      color: #003F8F;
      margin-bottom: 20px;
    }
    .img{
      width: 100%;
      height: 100vh;
      
    }
    .img img{
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .logo{
      text-align: center;
    }
    .logo h1{
      text-align: center;
      color: #003F8F;
      margin: 0;
    }
    .register{
      display: flex;
      justify-content: center;
      margin: 10px 0;
    }
    .register p{
      margin: 0px 10px;
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="img">
      <img src="https://cdn.discordapp.com/attachments/1426217970941821091/1426279812259119195/ChatGPT_Image_10_.._2568_11_46_37.png?ex=68eaa616&is=68e95496&hm=9995065f96c96d1fe5f05ed679684dbcf934a140df62bbba02a2610acc14f25a&" alt="">
    </div>
    <div class="login">
      <form id="loginForm" action="/login" method="POST">
        
        <div class="logo">
          <h1>เข้าสู่ระบบ</h1>
          <small>บริการระบบยืมและคืนอุปกรณ์ภายในบริษัท</small>
        </div>
        <label for="email">อีเมล</label>
        <input type="email" id="email" name="email" placeholder="example@company.com" required />

        <label for="password">รหัสผ่าน</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required />

        <input type="submit" value="เข้าสู่ระบบ">
        <div class="register">
          <p>ยังไม่มีบัญชี? </p><a href="/register"> สมัครสมาชิก</a>
        </div>
        
      </form>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <script>
    Swal.fire({
      icon: 'error',
      title: 'เข้าสู่ระบบไม่สำเร็จ',
      text: '<%= error %>',
      confirmButtonColor: '#d33'
    });
  </script>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
  <script>
    Swal.fire({
      icon: 'success',
      title: 'เข้าสู่ระบบสำเร็จ!',
      text: 'ยินดีต้อนรับเข้าสู่ระบบ',
      confirmButtonText: 'ตกลง',
      confirmButtonColor: '#003F8F',
      allowOutsideClick: false
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = "<%= success %>";
      }
    });
  </script>
  <% } %>

</body>
</html>