<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>
<body>
  <div class="container my-5">
    <h2 class="mb-4">ประเภทอุปกรณ์ทั้งหมด</h2>

    <!-- เพิ่ม Category -->
    <div class="card shadow mb-5">
      <div class="card-header bg-light"><h5>เพิ่มประเภทอุปกรณ์ใหม่</h5></div>
      <div class="card-body">
        <form action="/admin/addCategory" method="POST" class="row g-3 align-items-end">
          <div class="col-md-8 col-lg-9">
            <input type="text" name="name" class="form-control" placeholder="เช่น อุปกรณ์ IT" required>
          </div>
          <div class="col-md-4 col-lg-3">
            <button type="submit" class="btn btn-primary w-100">เพิ่มประเภท</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ตาราง Category -->
    <div class="card shadow">
      <div class="card-header bg-light">
        <h5>รายการทั้งหมด (<%= categories.length %>)</h5>
      </div>
      <div class="card-body p-0">
        <% if (categories.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>ชื่อประเภท</th>
                  <th class="text-center">จัดการ</th>
                </tr>
              </thead>
              <tbody>
                <% categories.forEach((category, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><%= category.name %></td>
                    <td class="text-center">
                      <a href="/admin/editCategory/<%= category._id %>" class="btn btn-sm btn-warning">แก้ไข</a>
                      <a href="/admin/deletecategory/<%= category._id %>" class="btn btn-sm btn-danger">ลบ</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="alert alert-info m-3">ยังไม่มีประเภทอุปกรณ์</div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
