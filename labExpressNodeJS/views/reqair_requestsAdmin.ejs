<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    .badge-pending { background:#f0ad4e; color:#fff; }
    .badge-inprogress { background:#17a2b8; color:#fff; }
    .badge-completed { background:#28a745; color:#fff; }
    .badge-rejected { background:#dc3545; color:#fff; }
    thead th { background:#0b5d9a; color:#fff; }
    
    .filter-form-row {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: nowrap;
    }
    
    .search-group {
      flex: 1;
      min-width: 200px;
    }
    
    .year-select {
      min-width: 120px;
      max-width: 150px;
    }
    
    .month-select, .status-select {
      min-width: 150px;
      max-width: 200px;
    }
    
    .reset-btn {
      min-width: 80px;
      background-color: #8220f1;
      color: white;
    }
    .reset-btn:hover {
      background-color: #2b91f7;
      color: white;
    }
    
    .btn-description {
      display: block;
      width: 100%;
      text-align: center;
      white-space: nowrap;
      padding: 0.375rem 0;
      font-size: 0.875rem;
    }
    
    option:disabled {
      color: #ccc !important;
    }
    
    @media (max-width: 992px) {
      .filter-form-row {
        flex-wrap: wrap;
      }
      .search-group {
        flex: 1 1 100%;
        margin-bottom: 0.5rem;
      }
      .year-select, .month-select, .status-select {
        flex: 1;
        min-width: 120px;
      }
    }
  </style>
</head>
<body>
  <h1 >รายการคำร้องซ่อม</h1>
  <small>จัดการรายการแจ้งซ่อม</small>
  <hr style="color: #3758F9;">
  <div class="card p-4">
    <div class="card-body">
      <form id="filterForm" class="mb-3" action="/admin/reqair_requestsadmin" method="get">
        <div class="filter-form-row">
          
          <!-- ช่องค้นหา -->
          <div class="search-group">
            <div class="input-group">
              <input type="text" 
                     name="q" 
                     class="form-control" 
                     placeholder="ค้นหา (อุปกรณ์, ผู้แจ้ง, คำอธิบาย)"
                     value="<%= (query && query.q) ? query.q : '' %>">
              <button class="btn btn-primary" type="submit">
                <i class="fa fa-search"></i> ค้นหา
              </button>
            </div>
          </div>

          <!-- ⭐ เลือกปี -->
          <select name="year" 
                  id="yearSelect"
                  class="form-select year-select" 
                  onchange="document.getElementById('filterForm').submit()">
            <option value="">ปีทั้งหมด</option>
            <% if (years && years.length) { %>
              <% years.forEach(function(y) { %>
                <option value="<%= y %>" <%= query.year == y ? 'selected' : '' %>>
                  <%= y + 543 %>
                </option>
              <% }); %>
            <% } %>
          </select>

          <!-- ⭐ เลือกเดือน (ลบ disabled ออก - ให้เลือกได้เสมอ) -->
          <select name="month" 
                  class="form-select month-select" 
                  onchange="document.getElementById('filterForm').submit()">
            <option value="">เดือนทั้งหมด</option>
            <% if (months && months.length) { %>
              <% months.forEach(function(m) { %>
                <option value="<%= m.value %>" 
                        <%= query.month === m.value ? 'selected' : '' %>
                        <%= !m.hasData ? 'disabled' : '' %>>
                  <%= m.label %><%= !m.hasData ? ' (ไม่มีข้อมูล)' : '' %>
                </option>
              <% }); %>
            <% } %>
          </select>

          <!-- เลือกสถานะ -->
          <select name="status" 
                  class="form-select status-select" 
                  onchange="document.getElementById('filterForm').submit()">
            <option value="">ทุกสถานะ</option>
            <% if (statuses && statuses.length) { %>
              <% statuses.forEach(function(s) { %>
                <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>>
                  <%= statusLabels[s] || s %>
                </option>
              <% }); %>
            <% } %>
          </select>

          <!-- ปุ่มรีเซ็ต -->
          <a href="/admin/reqair_requestsadmin" 
             class="btn btn-blue reset-btn"
             title="รีเซ็ตค่า">
            รีเซ็ตค่า
          </a>

        </div>
      </form>

      <!-- Alert เมื่อไม่พบข้อมูล -->
      <% if ((query.q || query.month || query.year || query.status) && items.length === 0) { %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <strong>ไม่พบข้อมูล</strong>
          <% if (query.q) { %>
            ที่ตรงกับคำค้นหา "<strong><%= query.q %></strong>"
          <% } %>
          <% if (query.year) { %>
            ในปี <strong><%= parseInt(query.year) + 543 %></strong>
          <% } %>
          <% if (query.month) { %>
            เดือน <strong><%= query.month %></strong>
          <% } %>
          <% if (query.status) { %>
            สำหรับสถานะ "<strong><%= statusLabels[query.status] || query.status %></strong>"
          <% } %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- แสดงผลการกรอง -->
      <% if (query.q || query.month || query.year || query.status) { %>
        <div class="alert alert-info mb-3">
          <small>
            แสดง <strong><%= items.length %></strong> รายการ
            <% if (query.q) { %> | คำค้นหา: "<strong><%= query.q %></strong>"<% } %>
            <% if (query.year) { %> | ปี: <strong><%= parseInt(query.year) + 543 %></strong><% } %>
            <% if (query.month) { %> | เดือน: <strong><%= query.month %></strong><% } %>
            <% if (query.status) { %> | สถานะ: <strong><%= statusLabels[query.status] || query.status %></strong><% } %>
          </small>
        </div>
      <% } %>

      <!-- ตารางข้อมูล -->
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width:50px">ลำดับ</th>
              <th style="width:180px">อุปกรณ์/ผู้แจ้ง</th>
              <th>คำอธิบาย</th>
              <th style="width:110px">สถานะ</th>
              <th style="width:140px">วันที่แจ้ง</th>
              <th style="width:120px">วันที่ซ่อมเสร็จ</th>
              <th style="width:140px">จัดการ</th>
            </tr>
          </thead>
          <tbody>
          <% if (!items || items.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">
                ไม่พบข้อมูล
              </td>
            </tr>
          <% } else { %>
            <% items.forEach(function(it, idx) { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td>
                  <div>
                    <strong>
                      <%= (it.equipment_id && it.equipment_id.name)
                        ? it.equipment_id.name
                        : '-' %>
                    </strong>
                  </div>
                  <div class="text-muted small">
                    <%= (it.user_id && it.user_id.fname && it.user_id.lname)
                      ? it.user_id.fname + ' ' + it.user_id.lname
                      : '-' %>
                  </div>
                </td>
                <td>
                  <div style="max-width: 350px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" 
                       title="<%= it.issue_description || '-' %>">
                    <%= it.issue_description || '-' %>
                  </div>
                </td>
                <td>
                  <% if (it.status === 'pending') { %>
                    <span class="badge badge-pending px-2 py-1">รอดำเนินการ</span>
                  <% } else if (it.status === 'in_progress') { %>
                    <span class="badge badge-inprogress px-2 py-1">กำลังดำเนินการ</span>
                  <% } else if (it.status === 'completed') { %>
                    <span class="badge badge-completed px-2 py-1">เสร็จสิ้น</span>
                  <% } else if (it.status === 'rejected') { %>
                    <span class="badge badge-rejected px-2 py-1">ยกเลิก</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= it.status %></span>
                  <% } %>
                </td>
                <td><small><%= formatThaiDate(it.created_at) %></small></td>
                <td>
                  <small>
                    <%= it.completion_date 
                        ? new Date(it.completion_date).toLocaleDateString('th-TH') 
                        : '-' %>
                  </small>
                </td>
                <td>
                  <a href="/admin/reqair_requests_detailadmin/<%= it._id %>" 
                     class="btn btn-primary btn-description"
                     title="ดูรายละเอียด">
                    ดูรายละเอียด
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</body>
</html> 