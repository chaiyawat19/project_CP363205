<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>รายการยืนยันการคืนอุปกรณ์</title>
</head>
<body>
    <header class="d-flex align-items-center justify-content-between">
        <div class="box1">
            <h1>รายการยืนยันคืนอุปกรณ์</h1>
            <small>เช็คสภาพอุปกรณ์เพื่อรวจสอบความเสียหาย</small>
        </div>
    </header>
    <hr style="color: #3758F9;">
    <div class="container-fluid">
        <div class="row d-flex align-items-center">
            <div class="col-6">
                <form action="/admin/returnequipment" method="GET" class="d-flex">
                    <input type="search" name="search" id="searchInput" class="form-control" placeholder="ค้นหาจากรายชื่อ, อุปกรณ์, หรือหมายเหตุ..." value="<%= typeof query !== 'undefined' ? query : '' %>">
                    <input type="submit" class="btn btn-secondary mx-2" value="ค้นหา">
                </form>
            </div>
             <div class="col-3">
                <select id="statusFilter" class="form-select my-3" aria-label="Default select example">
                    <option>เดือนนี้</option>
                    <option>เดือนก่อนหน้า</option>
                </select>
            </div>
            <div class="col-3">
                <select id="statusFilter" class="form-select my-3" aria-label="Default select example">
                    <option value="" selected>ทั้งหมด</option>
                    <option value="available">คืนอุปกรณ์แล้ว</option>
                    <option value="unavailable">รออนุมัติการคืน</option>
                    <option value="borrowed">กำลังยืมอยู่</option>
                </select>
            </div>
        </div>
    </div>
    <table class="table table-bordered align-middle text-center">
      <thead>
        <tr>
          <th>ลำดับ</th>
          <th>ชื่อ-นามสกุล</th>
          <th>อุปกรณ์</th>
          <th>หมายเหตุ</th>
          <th>สถานะ</th>
          <th>วันเวลาที่คืน</th>
          <th>จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% borrows.forEach((borrow, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= borrow.user_id.fname %><%= borrow.user_id.lname %></td>
            <td><%= borrow.equipment_id.name %></td>
            <td><%= borrow.note || '-' %></td>
            <td>
              <% if (borrow.status === 'waiting') { %>
                <p class="badge bg-info">รอคืนอุปกรณ์</p>
              <% } else if (borrow.status === 'returned') { %>
                <p class="badge bg-success">คืนอุปกรณ์แล้ว</p>
              <% } else if (borrow.status === 'borrowed') { %>
                <p class="badge bg-warning">กำลังยืมอยู่</span>
              <% } %>
            </td>
            <td>
              <%= borrow.actual_return_date ? borrow.actual_return_date.toLocaleString('th-TH') : '-' %>
            </td>
            <td>
              <% if (borrow.status === 'waiting') { %>
                <a href="/admin/approve-return/<%= borrow._id %>" class="btn btn-primary btn-sm">ยืนยันการคืน</a>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
