<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>รายการยืนยันการคืนอุปกรณ์</title>
</head>
<body>
    <h1>รายการยืนยันคืนอุปกรณ์</h1>
    <small>เช็คสภาพอุปกรณ์เพื่อตรวจสอบความเสียหาย</small>
  <hr style="color: #3758F9;">
   <div class="card p-4">
    <div class="card-body">
    <form id="filterForm" class="mb-3" action="/admin/returnequipment" method="get">
        <div class="filter-form-row">
          <!-- ช่องค้นหา -->
          <div class="search-group">
            <div class="input-group">
              <input type="text" 
                     name="q" 
                     class="form-control" 
                     placeholder="ค้นหา (อุปกรณ์, ผู้แจ้ง, คำอธิบาย)"
                     value="<%= (query && query.q) ? query.q : '' %>">
              <button class="btn btn-primary" type="submit">
                <i class="fa fa-search"></i> ค้นหา
              </button>
            </div>
          </div>
          <!-- เลือกสถานะ -->
          <select name="status" 
                  class="form-select status-select" 
                  onchange="document.getElementById('filterForm').submit()">
            <option value="">ทุกสถานะ</option>
            <% if (statuses && statuses.length) { %>
              <% statuses.forEach(function(s) { %>
                <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>>
                  <%= statusLabels[s] || s %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </form>
    <table class="table  table-hover text-center ">
        <tr>
          <th>ลำดับ</th>
          <th>รายชื่อ</th>
          <th>อุปกรณ์</th>
          <th>หมายเหตุ</th>
          <th>สถานะ</th>
          <th>วันเวลาที่คืน</th>
          <th>จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% borrows.forEach((borrow, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= borrow.user_id.fname %> <%= borrow.user_id.lname %></td>
            <td><%= borrow.equipment_id.name %></td>
            <td><%= borrow.note || '-' %></td>
            <td>
              <% if (borrow.status === 'waitingForReturn') { %>
                <span class="badge bg-warning text-dark">รอคืนอุปกรณ์</span>
              <% } else if (borrow.status === 'returned') { %>
                <span class="badge bg-success">คืนอุปกรณ์แล้ว</span>
              <% } %>
            </td>
            <td><%= borrow.actual_return_date ? borrow.actual_return_date.toLocaleString('th-TH') : '-' %></td>
            <td>
              <% if (borrow.status === 'waitingForReturn') { %>
                <button class="btn btn-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#confirmModal"
                        data-id="<%= borrow._id %>"
                        data-user="<%= borrow.user_id.fname + ' ' + borrow.user_id.lname %>"
                        data-equipment="<%= borrow.equipment_id.name %>">
                  ยืนยันการคืน
                </button>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ✅ Modal ยืนยันการคืน -->
  <div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="confirmForm" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">ยืนยันการคืนอุปกรณ์</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted mb-3">เลือกสภาพอุปกรณ์เพื่อตรวจสอบความเสียหาย</p>
            <div class="mb-3">
              <label class="form-label">หมายเหตุ</label>
              <input type="text" name="note" class="form-control" placeholder="คืนอุปกรณ์ภายในเวลาที่กำหนด">
            </div>
            <div class="mb-3">
              <label class="form-label">สภาพอุปกรณ์</label>
              <select name="condition" class="form-select" required>
                <option value="ปกติ">ปกติ</option>
                <option value="เสียหาย">เสียหาย</option>
                <option value="สูญหาย">สูญหาย</option>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
            <button type="submit" class="btn btn-primary">ส่ง</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script>
    // ✅ อัปเดต action ของ form ตอนกดปุ่ม "ยืนยันการคืน"
    const confirmModal = document.getElementById('confirmModal');
    confirmModal.addEventListener('show.bs.modal', event => {
      const button = event.relatedTarget;
      const id = button.getAttribute('data-id');
      document.getElementById('confirmForm').action = `/admin/confirmreturn/${id}`;
    });
  </script>
</body>
</html>
